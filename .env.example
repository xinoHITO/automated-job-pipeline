# ─── Notion (results database) ────────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=

# ID of the target database page and its data source
DATABASE_ID=
DATA_SOURCE_ID=

# ─── Google Gemini (scoring + cover letters) ─────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

API_SECRET_TOKEN=

DISCORD_WEBHOOK_URL=

# Amount tickets that are allowed to process at the same time. 
# CAREFUL! Measure this according to your hardware 
MAX_CONCURRENT_TICKETS=2

SLEEP_AFTER_RUN=0